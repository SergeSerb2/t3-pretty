#!/usr/bin/env bash
# PATH shim used by publish-mobile-release.sh during `eas build --local`.
#
# On macOS 26 (Tahoe) / Xcode 27, EAS imports the distribution cert into an
# ephemeral keychain, then `security find-identity -v` reports 0 valid
# identities because that keychain has no Apple WWDR/root chain
# (expo/eas-cli#3678). Drop -v for those lookups only so the presence check
# can pass. Codesign still validates trust later via Security.framework.
set -euo pipefail

real="${T3CODE_REAL_SECURITY:-/usr/bin/security}"

if [[ "${1:-}" == "find-identity" ]]; then
  eas_keychain=0
  for arg in "$@"; do
    if [[ "$arg" == *eas-build-*.keychain* ]]; then
      eas_keychain=1
      break
    fi
  done
  if [[ "$eas_keychain" -eq 1 ]]; then
    args=()
    for arg in "$@"; do
      if [[ "$arg" == "-v" ]]; then
        continue
      fi
      args+=("$arg")
    done
    exec "$real" "${args[@]}"
  fi
fi

exec "$real" "$@"
